# Copy this file to ".env" and fill in your own values.
# The ".env" file is private. Never share it or commit it to Git.
# The app runs fine without a .env file; everything below is optional.

# --- Only for scripts/load_to_mysql.py ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=dataguard

# --- Alerts when the health score drops (all optional) ---
# Telegram: create a bot with @BotFather, then find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack / Teams / any webhook that accepts a JSON body {"text": "..."}
ALERT_WEBHOOK_URL=

# --- Display settings ---
# The sample retail data is in GBP. Set INR to convert for display.
DISPLAY_CURRENCY=GBP
GBP_TO_INR=127.14
