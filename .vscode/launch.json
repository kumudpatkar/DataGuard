{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DataGuard: run the app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "DataGuard: run the daily script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_daily.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
